add_action( 'wp_footer', 'ac_btn_relink_js', 99 );
function ac_btn_relink_js() {
    global $TRP_LANGUAGE;
    if ( empty( $TRP_LANGUAGE ) || $TRP_LANGUAGE !== 'en_US' ) return;
    $map = ac_btn_relink_map();
    if ( empty( $map ) ) return;
    ?>
<script id="ac-btn-relink">
(function () {
    var MAP = <?php echo json_encode( $map, JSON_UNESCAPED_SLASHES ); ?>;
    var MARK = 'data-ac-relinked';
    function relink() {
        document.querySelectorAll('.elementor-widget-button .elementor-button-wrapper.translation-block').forEach(function (wrapper) {
            // Never process twice (TRP dynamic translator may re-create wrappers)
            if (wrapper.getAttribute(MARK)) return;
            var widget = wrapper.closest('.elementor-widget-button');
            if (!widget) return;
            var id = widget.getAttribute('data-id');
            if (!id || !MAP[id]) return;
            if (wrapper.querySelector('a[href]')) return;
            // Skip empty wrappers (avoids dead <a></a> in race conditions)
            var text = (wrapper.textContent || '').replace(/\s+/g, ' ').trim();
            if (!text) { wrapper.setAttribute(MARK, '1'); return; }
            var info = MAP[id];
            var a = document.createElement('a');
            a.href = info.href;
            if (info.class) a.className = info.class;
            if (info.target) a.target = info.target;
            if (info.target === '_blank') a.rel = 'noopener noreferrer';
            // Rebuild full Elementor button structure (icon + content-wrapper + text)
            var wrap = document.createElement('span');
            wrap.className = 'elementor-button-content-wrapper';
            var txt = document.createElement('span');
            txt.className = 'elementor-button-text';
            txt.textContent = text;
            if (id === '315acd2a') {
                // Header widget: add icon span for the teal gradient badge (design)
                var ic = document.createElement('span');
                ic.className = 'elementor-button-icon';
                ic.setAttribute('aria-hidden', 'true');
                wrap.appendChild(ic);
            }
            wrap.appendChild(txt);
            a.appendChild(wrap);
            wrapper.textContent = '';
            wrapper.classList.remove('translation-block');
            wrapper.appendChild(a);
            wrapper.setAttribute(MARK, '1');
        });
    }


    function boot() {
        relink();
        // TRP dynamic translator + Elementor re-render can re-wrap text at any time.
        // Watch the DOM and re-link anything new, debounced.
        var timer = null;
        var observer = new MutationObserver(function () {
            if (timer) clearTimeout(timer);
            timer = setTimeout(relink, 150);
        });
        observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();
</script>
    <?php
}


// ========== 4b. Nine Essential Features: per-slide data attributes (all languages) ==========
add_action( 'wp_footer', 'ac_feat_attrs_js', 100 );
function ac_feat_attrs_js() {
    ?>
<script id="ac-feat-attrs">
(function () {
    var MARK = 'data-ac-feat-ready';
    function apply() {
        document.querySelectorAll('.elementor-element-015d86b .swiper-slide .elementor-testimonial').forEach(function (t) {
            if (t.getAttribute(MARK)) return;
            var cite = t.querySelector('.elementor-testimonial__cite');
            if (!cite) return;
            var m = cite.textContent.replace(/\s+/g, ' ').trim().match(/^(\d+)[.、．]\s*(.+?)[:：]?\s*$/);
            if (!m) return;
            var num = m[1], cat = m[2];
            // attr() in CSS reads only the element the pseudo belongs to,
            // so set the attrs on testimonial (watermark), header (chip) and content (title).
            t.setAttribute('data-ac-num', num);
            t.setAttribute('data-ac-cat', cat);
            var h = t.querySelector('.elementor-testimonial__header');
            var c = t.querySelector('.elementor-testimonial__content');
            if (h) { h.setAttribute('data-ac-cat', cat); }
            if (c) { c.setAttribute('data-ac-num', num); c.setAttribute('data-ac-cat', cat); }
            t.setAttribute(MARK, '1');
        });
    }
    function boot() {
        apply();
        var timer = null;
        var observer = new MutationObserver(function () {
            if (timer) clearTimeout(timer);
            timer = setTimeout(apply, 150);
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();
</script>
    <?php
}

